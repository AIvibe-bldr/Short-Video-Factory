# === 必須 ===
# Claude API キー (トレンド分析・台本生成に使用)
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=

# === トレンド収集 (使うプラットフォームのみ設定) ===
# YouTube Data API v3 キー (Google Cloud Console で取得)
YOUTUBE_API_KEY=

# Instagram Graph API (ビジネス/クリエイターアカウントが必要)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# === 音声合成 (任意: 未設定なら無料の edge-tts を使用) ===
# ElevenLabs (高品質な多言語音声)
ELEVENLABS_API_KEY=

# VOICEVOX (無料・日本語。ローカルでエンジンを起動して使用)
VOICEVOX_URL=http://localhost:50021

# === AI動画生成 (任意: 人物が登場するスタイルで使用) ===
# HeyGen (AIアバターが商品を紹介する動画)
HEYGEN_API_KEY=

# === GA4自動同期 (任意: svf sync-ga4 で使用) ===
# GA4のプロパティID (管理 > プロパティ設定 に表示される数字)
GA4_PROPERTY_ID=
# サービスアカウントのJSONキーのパス
# (Google Cloudでサービスアカウントを作成し、GA4側で閲覧者権限を付与)
GOOGLE_APPLICATION_CREDENTIALS=
